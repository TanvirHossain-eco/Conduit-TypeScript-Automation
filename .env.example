# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to ".env" (same folder) and fill in real values.
# ".env" itself should NEVER be committed to source control — add it to .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# Application + API base URLs
BASE_URL='Enter Your Website URL'
API_URL='Enter Your API URL'

# Valid, already-registered account
EMAIL="Enter Valid Email Address"
PASSWORD="Enter valid Password"

# Deliberately wrong password, used by the negative-login stage in beforeEach
INVALID_PASSWORD="Enter Invalid Password"

# The registered username tied to EMAIL/PASSWORD above — used to confirm
# article authorship during discovery and before edit/delete
AUTHOR_USERNAME="Enter Valid Username"
